    "faq": {
      "q1": "How do I edit my profile?",
      "a1": "Go to Settings > Account & Profile > Edit Profile to update your photo, bio and information.",
      "q2": "Why isn't my video appearing in the feed?",
      "a2": "Check that your video is in 'Published' status, not 'Draft'. Private videos only appear to you.",
      "q3": "How do I make a payment via Natcash?",
      "a3": "Go to the Premium section, click 'Go Premium' and follow the instructions to send the amount to the indicated Natcash number.",
      "q4": "How do I change my username?",
      "a4": "Go to Settings > Edit Profile. Your username can only be changed once per month. A 30-day wait is required between changes.",
      "q5": "What to do if my account was hacked?",
      "a5": "Immediately change your password and enable two-factor authentication. Report the issue to us via the 'Report a bug' button."
    }
